# ---------------------------------------------------------------------------
# 本地默认值。这里只放【非敏感】配置，可以安全提交。
# 密钥 / 令牌请写在 .env.local（已 gitignore），或由部署环境注入。
# 所有变量都在 .env.example 里有一行说明，新增变量请同步更新那里。
# ---------------------------------------------------------------------------

# 后端监听地址。127.0.0.1 仅本机可访问；容器内需设为 0.0.0.0。
HOST=127.0.0.1
PORT=3000

# Vite 开发服务器端口（仅 dev 使用，生产由后端直接托管静态资源）。
WEB_PORT=5173

# 日志过滤，语法见 https://docs.rs/tracing-subscriber/latest/tracing_subscriber/filter/struct.EnvFilter.html
RUST_LOG=info,{{crate_name}}=debug
